# 运行环境标识；local 开发时可开更多调试日志
APP_ENV=local

# PostgreSQL 连接串，需已安装 pgvector 扩展
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/rag_center

# Embedding 模型：文档切块与检索时把文本转成向量。须与 EMBEDDING_DIMENSIONS 一致，换模型后需全量 reindex
MODEL_BASE_URL=https://api.openai.com/v1
MODEL_API_KEY=your-api-key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=10

# LLM：用于 query 改写、LLM rerank 等可选能力，与 Embedding 可指向不同厂商
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=your-deepseek-api-key
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_SECONDS=60

# 向量与关键词双存储：pgvector 做语义检索，Elasticsearch 做 BM25（hybrid/bm25 模式依赖 ES）
VECTOR_STORE=pgvector
KEYWORD_SEARCH_PROVIDER=elasticsearch
ELASTICSEARCH_URL=http://localhost:9200
ELASTICSEARCH_INDEX=rag_chunks
ELASTICSEARCH_TIMEOUT_SECONDS=30

# 检索模式与 hybrid 融合：vector 纯向量；hybrid 两路召回后 RRF 融合排序
RETRIEVAL_MODE=vector
HYBRID_FUSION=rrf
HYBRID_RRF_K=60
HYBRID_VECTOR_TOP_K=20
HYBRID_BM25_TOP_K=20
HYBRID_TOP_N=20

# 文档切块与 retrieve 默认参数：结构化切块的最大块长、重叠、表格分组行数等
CHUNK_SIZE=800
CHUNK_OVERLAP=100
TABLE_MAX_ROWS_PER_CHUNK=10
TOP_K=5
MULTI_KB_MAX=5
QUERY_MAX_LENGTH=2000

# LLM 重排：召回后再用模型对候选片段精排，默认关闭，pro 档 quality profile 可开启
RERANK_ENABLED=false
RERANK_PROVIDER=llm
RERANK_TOP_N=5
RERANK_MAX_CANDIDATES=20
RERANK_CHUNK_MAX_CHARS=1024
RERANK_TEMPERATURE=0.0

# Query 改写：用 LLM 把口语化问题改写成更利于检索的表述，默认关闭
QUERY_REWRITE_ENABLED=false
QUERY_REWRITE_TIMEOUT_MS=2000

# 日志：按天滚动，error.log 单独收 ERROR 便于排查
LOG_LEVEL=INFO
LOG_DIR=logs
LOG_MAX_BYTES=20971520
LOG_BACKUP_COUNT=5
LOG_ERROR_MAX_BYTES=20971520
LOG_ERROR_BACKUP_COUNT=10
LOG_DAILY_BACKUP_COUNT=14
LOG_BODY_MAX_CHARS=4000
LOG_LLM_MAX_CHARS=8000
LOG_REQUEST_BODY=true
LOG_RESPONSE_BODY=true

# API Key 鉴权：local 调试可设 false，自动使用 tenant_demo
AUTH_ENABLED=true

# Celery 异步索引：upload 后切片、Embedding、写库在 Worker 中执行，依赖 Redis
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Langfuse 检索可观测：记录 trace/span，配合反馈 API 做效果分析；不用可保持 false
LANGFUSE_ENABLED=false
LANGFUSE_HOST=http://localhost:3000
LANGFUSE_PUBLIC_KEY=pk-lf-00f2746a-716b-42b9-b543-f906f7cfccd0
LANGFUSE_SECRET_KEY=sk-lf-13795f7c-a8ae-4273-b333-120fd3b07468
